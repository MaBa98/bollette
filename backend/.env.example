ENVIRONMENT=prod
# Supabase → Project Settings → Database → Connection string → "Session pooler" (IPv4, porta 5432)
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_BEHIND_PGBOUNCER=false
SUPABASE_URL=https://<ref>.supabase.co
# Solo per progetti con JWT legacy HS256; lasciare vuoto per verifica via JWKS
JWT_SECRET=
CORS_ORIGINS=["https://<tuo-progetto>.vercel.app"]
